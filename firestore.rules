rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /guests/{docId} {
      allow read, write: if request.auth != null;
    }
    match /vendors/{docId} {
      allow read, write: if request.auth != null;
    }
    match /venues/{docId} {
      allow read, write: if request.auth != null;
    }
    match /budgetItems/{docId} {
      allow read, write: if request.auth != null;
    }
    match /checklistItems/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
